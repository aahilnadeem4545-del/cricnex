{
  "name": "cricnex",
  "version": "1.0.0",
  "private": true,
  "description": "CRICNEX - Enterprise cricket management and ball-by-ball scoring system",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:ui": "vite --config src/ui/vite.config.ts",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "vite build --config src/ui/vite.config.ts",
    "build": "npm run build:server && npm run build:ui",
    "start": "node dist/server.js",
    "test": "tsx --test tests/**/*.test.ts",
    "test:engine": "tsx --test tests/engine.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
